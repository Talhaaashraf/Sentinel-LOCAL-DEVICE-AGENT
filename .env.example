# ---- AI brain -------------------------------------------------------------
# Default: free, local Ollama. Install from https://ollama.com then:
#   ollama pull qwen2.5:3b-instruct      (runs on CPU with 16 GB RAM, supports tool calling)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_NUM_CTX=8192

# Optional cloud brain instead of Ollama: set LLM_PROVIDER=groq and a key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- Access ---------------------------------------------------------------
ADMIN_API_KEY=replace_with_a_long_random_admin_key
DASHBOARD_PASSWORD=replace_with_a_separate_dashboard_password

# ---- Remote repair safety -------------------------------------------------
# Raw remote shell is OFF by default. Only turn this on if you understand it.
ALLOW_REMOTE_SHELL=false
# Shown in install one-liners when the server is behind a fixed LAN address.
# PUBLIC_SERVER_URL=http://192.168.1.10:8000
