# Copy to .env before `docker compose up`. Keep .env private (it is gitignored).

# ---- Dashboard access (required) ------------------------------------------
# A single shared password gates the dashboard, its API and the WebSocket.
DASHBOARD_PASSWORD=change-me-to-a-long-password
# Separate key required to generate agent enrollment tokens.
ADMIN_API_KEY=change-me-to-a-long-random-admin-key

# ---- Public address (recommended) ----------------------------------------
# The URL agents should call back on. Set it to this server's LAN address so the
# copy-paste install one-liners always point at the right host. If left blank,
# the app infers it from the incoming request (works behind nginx thanks to
# --proxy-headers, but an explicit value is more reliable).
# PUBLIC_SERVER_URL=http://192.168.1.10

# ---- LLM brain ------------------------------------------------------------
# Ollama runs as a container (service name "ollama"); OLLAMA_URL is set in
# docker-compose.yml. After the stack is up, pull the model once:
#   docker compose exec ollama ollama pull qwen2.5:3b-instruct
OLLAMA_MODEL=qwen2.5:3b-instruct

# ---- Remote repair safety -------------------------------------------------
# Raw remote shell stays OFF unless you deliberately enable it.
ALLOW_REMOTE_SHELL=false

# ---- Notifications (optional) ---------------------------------------------
# Get emailed / pinged when a device goes critical. Leave blank to disable.
ALERT_MIN_SEVERITY=critical
# Slack/Teams/generic incoming webhook URL:
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Email via SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@example.com
# ALERT_EMAIL_TO=tech1@example.com,tech2@example.com
# Daily fleet summary email/webhook:
# SUMMARY_ENABLED=true
